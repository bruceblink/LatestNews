{
  "manifestVersion": 1,
  "id": "org.latestnews.juejin",
  "name": "稀土掘金",
  "version": "0.1.0",
  "apiVersion": "^1.0.0",
  "runtime": "trusted-js",
  "entry": "plugin.ts",
  "targets": ["node", "electron"],
  "permissions": {
    "network": [{ "origin": "https://api.juejin.cn", "methods": ["GET"] }]
  },
  "limits": {
    "maxExecutionMs": 15000,
    "maxRequestsPerRun": 16,
    "maxRequestBodyBytes": 16384,
    "maxResponseBytes": 2097152,
    "maxResponseBytesPerRun": 8388608,
    "maxItems": 30,
    "maxOutputBytes": 262144
  },
  "sources": [
    {
      "id": "juejin",
      "name": "稀土掘金",
      "kind": "hottest",
      "refreshIntervalSeconds": 600,
      "column": "tech",
      "home": "https://juejin.cn"
    }
  ]
}
