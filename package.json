{
    "name": "latestnews",
    "type": "module",
    "version": "0.6.1",
    "private": true,
    "license": "AGPL-3.0-only",
    "packageManager": "pnpm@10.30.3",
    "author": {
        "name": "likanug",
        "email": "likanug.g@qq.com",
        "url": "https://github.com/bruceblink"
    },
    "repository": "https://github.com/bruceblink/latestnews",
    "homepage": "https://news.likanug.top",
    "scripts": {
        "brand:assets": "node ./scripts/brand-assets.mjs",
        "dev": "pnpm presource && vite dev",
        "build": "pnpm presource && vite build",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "commitlint": "commitlint --edit",
        "presource": "tsx ./scripts/favicon.ts && tsx ./scripts/source.ts",
        "crawler": "tsx ./crawler-platform/cli.ts",
        "start": "node --env-file .env.server dist/output/server/index.mjs",
        "build:pages": "cross-env CF_PAGES=1 pnpm build",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
        "check": "pnpm lint:check && pnpm typecheck && pnpm test",
        "release": "bumpp",
        "prepare": "simple-git-hooks",
        "test": "vitest -c vitest.config.ts",
        "test:e2e": "playwright test --config=playwright.config.ts",
        "test:e2e:web": "playwright test --config=playwright.config.ts",
        "test:e2e:electron": "playwright test --config=playwright.electron.config.ts",
        "caching": "ts-node ./server/database/caching.ts",
        "electron:dev": "pnpm presource && node scripts/electron-icon.mjs && cross-env NODE_ENV=development electron-vite dev",
        "electron:build": "pnpm presource && cross-env NODE_ENV=production electron-vite build && node scripts/prepare-electron-package.mjs && node scripts/electron-icon.mjs",
        "electron:package:win": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --win nsis --publish never",
        "electron:package:mac": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --mac dmg zip --publish never",
        "electron:package:linux": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --linux AppImage deb --publish never",
        "test:crawler:electron": "pnpm exec tsx scripts/crawler/electron-host-smoke.ts",
        "test:crawler:docker": "pnpm exec tsx scripts/crawler/docker-host-smoke.ts",
        "performance:baseline": "cross-env LATESTNEWS_SKIP_FAVICON_FETCH=true pnpm build && pnpm exec tsx scripts/performance/api-baseline.ts",
        "performance:web-baseline": "cross-env LATESTNEWS_SKIP_FAVICON_FETCH=true pnpm build && pnpm exec tsx scripts/performance/web-baseline.ts",
        "performance:electron-lifecycle": "pnpm electron:build && pnpm exec tsx scripts/performance/electron-lifecycle.ts",
        "source-quality:sample": "pnpm exec tsx scripts/performance/source-quality-sample.ts",
        "source-quality:report": "pnpm exec tsx scripts/performance/source-quality-report.ts",
        "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json --composite false",
        "test:electron": "vitest -c vitest.config.ts run test/electron-api-proxy.test.ts test/electron-security.test.ts test/electron-synchub-policy.test.ts test/electron-synchub-storage.test.ts",
        "asar:list": "asar list release/win-unpacked/resources/app.asar"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
        "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
        "@formkit/auto-animate": "^0.8.4",
        "@iconify-json/si": "^1.2.17",
        "@radix-ui/react-dialog": "^1.3.1",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-query-devtools": "^5.104.5",
        "@tanstack/react-router": "^1.170.46",
        "@unocss/reset": "^66.11.0",
        "ahooks": "^3.10.0",
        "better-sqlite3": "^13.0.3",
        "buffer": "^6.0.3",
        "cheerio": "^1.2.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "consola": "^3.4.2",
        "cookie-es": "^3.1.1",
        "dayjs": "1.11.13",
        "db0": "^0.4.1",
        "defu": "^6.1.7",
        "dotenv": "^17.4.2",
        "dotenv-flow": "^4.1.0",
        "fast-xml-parser": "^5.11.2",
        "framer-motion": "^12.43.0",
        "h3": "^2.0.8",
        "iconv-lite": "^0.7.3",
        "jose": "^6.2.13",
        "jotai": "^2.20.3",
        "jwt-decode": "^4.0.0",
        "md5": "^2.3.0",
        "ofetch": "^1.5.1",
        "overlayscrollbars": "^2.17.0",
        "react": "^18.3.1",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.3.1",
        "react-use": "^17.6.1",
        "uncrypto": "^0.1.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@electron/asar": "4.3.1",
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@iconify-json/ph": "^1.2.2",
        "@napi-rs/pinyin": "^1.8.0",
        "@ourongxing/tsconfig": "^0.0.4",
        "@playwright/test": "^1.64.1",
        "@resvg/resvg-js": "^2.6.2",
        "@rollup/pluginutils": "^5.5.1",
        "@tanstack/router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.48",
        "@types/node": "22.20.5",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@unocss/rule-utils": "^66.11.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "bumpp": "^10.4.1",
        "cross-env": "^10.1.0",
        "electron": "44.9.0",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-perfectionist": "^4.15.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fast-glob": "^3.3.3",
        "favicons-scraper": "^1.3.2",
        "globals": "^16.5.0",
        "lint-staged": "^15.5.2",
        "nitro": "3.0.260903-beta",
        "pnpm-patch-i": "^0.4.1",
        "prettier": "^3.9.10",
        "simple-git-hooks": "^2.14.0",
        "ts-node": "10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "unimport": "^4.2.0",
        "unocss": "^66.11.0",
        "vite": "8.3.5",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^3.2.7",
        "workbox-build": "^7.4.1",
        "workbox-window": "^7.4.1"
    },
    "pnpm": {
        "patchedDependencies": {
            "dayjs": "patches/dayjs.patch"
        },
        "overrides": {
            "cross-spawn": ">=7.0.6",
            "picomatch": "^4.0.2"
        },
        "onlyBuiltDependencies": [
            "@napi-rs/pinyin",
            "@parcel/watcher",
            "@swc/core",
            "esbuild",
            "better-sqlite3",
            "sharp",
            "simple-git-hooks",
            "unrs-resolver",
            "workerd",
            "electron"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "pnpm exec commitlint --edit $1"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
    },
    "description": "A cross-platform reader for the latest news.",
    "main": "out/main/main.cjs"
}
