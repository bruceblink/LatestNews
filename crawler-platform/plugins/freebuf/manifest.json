{
  "manifestVersion": 1,
  "id": "org.latestnews.freebuf",
  "name": "Freebuf",
  "version": "0.1.0",
  "apiVersion": "^1.0.0",
  "runtime": "trusted-js",
  "entry": "plugin.ts",
  "targets": ["node", "electron"],
  "permissions": {
    "network": [{ "origin": "https://www.freebuf.com", "methods": ["GET"] }]
  },
  "limits": {
    "maxExecutionMs": 15000,
    "maxRequestsPerRun": 16,
    "maxRequestBodyBytes": 16384,
    "maxRequestHeadersBytes": 16384,
    "maxResponseBytes": 2097152,
    "maxResponseHeadersBytes": 16384,
    "maxResponseBytesPerRun": 8388608,
    "maxItems": 30,
    "maxOutputBytes": 262144
  },
  "sources": [
    {
      "id": "freebuf",
      "name": "Freebuf",
      "kind": "hottest",
      "refreshIntervalSeconds": 600,
      "column": "china",
      "title": "网络安全",
      "home": "https://www.freebuf.com/"
    }
  ]
}
