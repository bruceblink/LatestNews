{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server",
    "electron/api-proxy.ts",
    "electron/security.ts",
    "electron/synchub-policy.ts",
    "electron/synchub-storage.ts",
    "*.config.*",
    "vite.renderer.ts",
    "shared",
    "test",
    "scripts",
    "tools"
  ],
  "exclude": [
    "eslint.config.mjs",
    "electron.vite.config.ts",
    "dist/.nitro/types"
  ]
}
