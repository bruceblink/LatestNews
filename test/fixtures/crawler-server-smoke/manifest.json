{
  "manifestVersion": 1,
  "id": "org.latestnews.server-smoke",
  "name": "Node server integration smoke",
  "version": "0.1.0",
  "apiVersion": "^1.0.0",
  "runtime": "trusted-js",
  "entry": "plugin.ts",
  "targets": ["node"],
  "permissions": { "network": [] },
  "sources": [
    {
      "id": "hackernews",
      "name": "Hacker News",
      "kind": "hottest",
      "refreshIntervalSeconds": 600
    }
  ]
}
