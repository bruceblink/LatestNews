{
  "manifestVersion": 1,
  "id": "org.latestnews.example-json",
  "name": "Example JSON Feed",
  "version": "0.1.0",
  "apiVersion": "^1.0.0",
  "runtime": "trusted-js",
  "entry": "plugin.ts",
  "targets": ["node", "electron"],
  "permissions": {
    "network": [{ "origin": "https://json.example.test", "methods": ["GET"] }]
  },
  "sources": [{ "id": "latest", "name": "Latest", "kind": "timeline", "refreshIntervalSeconds": 300 }]
}
