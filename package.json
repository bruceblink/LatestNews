{
    "name": "latestnews",
    "type": "module",
    "version": "0.6.1",
    "private": true,
    "license": "AGPL-3.0-only",
    "packageManager": "pnpm@10.30.3",
    "author": {
        "name": "likanug",
        "email": "likanug.g@qq.com",
        "url": "https://github.com/bruceblink"
    },
    "repository": "https://github.com/bruceblink/latestnews",
    "homepage": "https://news.likanug.top",
    "scripts": {
        "brand:assets": "node ./scripts/brand-assets.mjs",
        "dev": "pnpm presource && vite dev",
        "build": "pnpm presource && vite build",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "commitlint": "commitlint --edit",
        "presource": "tsx ./scripts/favicon.ts && tsx ./scripts/source.ts",
        "start": "node --env-file .env.server dist/output/server/index.mjs",
        "preview": "cross-env CF_PAGES=1 pnpm build && wrangler pages dev dist/output/public",
        "deploy": "cross-env CF_PAGES=1 pnpm build && wrangler pages deploy dist/output/public",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
        "check": "pnpm lint:check && pnpm typecheck && pnpm test",
        "release": "bumpp",
        "prepare": "simple-git-hooks",
        "log": "wrangler pages deployment tail --project-name latestnews",
        "test": "vitest -c vitest.config.ts",
        "caching": "ts-node ./server/database/caching.ts",
        "electron:dev": "pnpm presource && node scripts/electron-icon.mjs && cross-env NODE_ENV=development electron-vite dev",
        "electron:build": "pnpm presource && cross-env NODE_ENV=production electron-vite build && node scripts/prepare-electron-package.mjs && node scripts/electron-icon.mjs",
        "electron:package:win": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --win nsis --publish never",
        "electron:package:mac": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --mac dmg zip --publish never",
        "electron:package:linux": "pnpm electron:build && electron-builder --projectDir out --config ../electron-builder.yml --linux AppImage deb --publish never",
        "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json --composite false",
        "test:electron": "vitest -c vitest.config.ts run test/electron-api-proxy.test.ts test/electron-security.test.ts test/electron-synchub-policy.test.ts test/electron-synchub-storage.test.ts",
        "asar:list": "asar list release/win-unpacked/resources/app.asar"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
        "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
        "@formkit/auto-animate": "^0.8.4",
        "@iconify-json/si": "^1.2.17",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@tanstack/react-query": "^5.104.3",
        "@tanstack/react-query-devtools": "^5.104.3",
        "@tanstack/react-router": "^1.170.45",
        "@unocss/reset": "^66.11.0",
        "ahooks": "^3.10.0",
        "better-sqlite3": "^11.10.0",
        "buffer": "^6.0.3",
        "cheerio": "^1.2.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "consola": "^3.4.2",
        "cookie-es": "^2.0.1",
        "dayjs": "1.11.13",
        "db0": "^0.3.4",
        "defu": "^6.1.7",
        "dotenv": "^17.4.2",
        "dotenv-flow": "^4.1.0",
        "fast-xml-parser": "^5.11.2",
        "framer-motion": "^12.43.0",
        "h3": "^1.15.11",
        "iconv-lite": "^0.6.3",
        "jose": "^6.2.12",
        "jotai": "^2.20.3",
        "jwt-decode": "^4.0.0",
        "md5": "^2.3.0",
        "ofetch": "^1.5.1",
        "overlayscrollbars": "^2.16.0",
        "react": "^18.3.1",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.3.1",
        "react-use": "^17.6.1",
        "uncrypto": "^0.1.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@electron/asar": "3.4.1",
        "@eslint-react/eslint-plugin": "^5.28.0",
        "@eslint/js": "^10.0.1",
        "@iconify-json/ph": "^1.2.2",
        "@napi-rs/pinyin": "^1.8.0",
        "@ourongxing/tsconfig": "^0.0.4",
        "@resvg/resvg-js": "^2.6.2",
        "@rollup/pluginutils": "^5.4.0",
        "@tanstack/router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.47",
        "@types/node": "22.15.32",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@unocss/rule-utils": "^66.11.0",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "bumpp": "^10.4.1",
        "cross-env": "^7.0.3",
        "electron": "44.9.0",
        "electron-builder": "26.15.3",
        "electron-vite": "6.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-perfectionist": "^4.15.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fast-glob": "^3.3.3",
        "favicons-scraper": "^1.3.2",
        "globals": "^16.5.0",
        "lint-staged": "^15.5.2",
        "pnpm-patch-i": "^0.4.1",
        "prettier": "^3.9.10",
        "rollup": "^4.64.7",
        "simple-git-hooks": "^2.14.0",
        "ts-node": "10.9.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2",
        "unimport": "^4.2.0",
        "unocss": "^66.11.0",
        "vite": "7.3.1",
        "vite-plugin-pwa": "^2.0.0",
        "vite-plugin-with-nitro": "0.0.5",
        "vitest": "^3.2.7",
        "workbox-build": "^7.4.1",
        "workbox-window": "^7.4.1",
        "wrangler": "^4.151.1"
    },
    "pnpm": {
        "patchedDependencies": {
            "dayjs": "patches/dayjs.patch"
        },
        "overrides": {
            "nitro-go>h3": "1.15.11",
            "unenv": "1.10.0",
            "cross-spawn": ">=7.0.6",
            "picomatch": "^4.0.2"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "vite-plugin-with-nitro@0.0.5>vite": "7.3.1"
            }
        },
        "onlyBuiltDependencies": [
            "@napi-rs/pinyin",
            "@parcel/watcher",
            "@swc/core",
            "esbuild",
            "better-sqlite3",
            "sharp",
            "simple-git-hooks",
            "unrs-resolver",
            "workerd",
            "electron"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged",
        "commit-msg": "pnpm exec commitlint --edit $1"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
    },
    "description": "A cross-platform reader for the latest news.",
    "main": "out/main/main.cjs"
}
